rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if isAuthenticated() and isOwner(userId);
      
      // Medicines subcollection
      match /medicines/{medicineId} {
        allow read: if isAuthenticated() and isOwner(userId);
        allow create: if isAuthenticated() and isOwner(userId) 
                      && request.resource.data.keys().hasAll(['name', 'description', 'type', 'quantity', 'initialQuantity', 'unit', 'expiryDate', 'tags', 'createdAt', 'updatedAt'])
                      && request.resource.data.userId == userId;
        allow update: if isAuthenticated() and isOwner(userId)
                      && !request.resource.data.keys().hasAny(['userId', 'createdAt']);
        allow delete: if isAuthenticated() and isOwner(userId);
      }
      
      // Shopping list subcollection
      match /shoppingList/{itemId} {
        allow read: if isAuthenticated() and isOwner(userId);
        allow create: if isAuthenticated() and isOwner(userId)
                      && request.resource.data.keys().hasAll(['name', 'isPurchased', 'createdAt', 'updatedAt'])
                      && request.resource.data.userId == userId;
        allow update: if isAuthenticated() and isOwner(userId)
                      && !request.resource.data.keys().hasAny(['userId', 'createdAt']);
        allow delete: if isAuthenticated() and isOwner(userId);
      }
      
      // Tags subcollection (for future use)
      match /tags/{tagId} {
        allow read, write: if isAuthenticated() and isOwner(userId);
      }
    }
  }
}
